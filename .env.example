# Genesis Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_DB=genesis
POSTGRES_USER=genesis
POSTGRES_PASSWORD=genesis
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# =============================================================================
# NATS
# =============================================================================
NATS_PORT=4222
NATS_MONITORING_PORT=8222
NATS_HOST=nats

# =============================================================================
# MinIO (S3-compatible object storage)
# =============================================================================
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_HOST=minio
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123

# =============================================================================
# Genesis Platform
# =============================================================================
GENESIS_ENV=development
GENESIS_LOG_LEVEL=info

# =============================================================================
# API Security — REQUIRED in all environments
# =============================================================================
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: Never use the same secret across environments.
# WARNING: Never commit a real JWT_SECRET to version control.
JWT_SECRET=

# JWT token expiry in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed CORS origins
# For local development: http://localhost:3000
# For production: https://your-domain.com
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Database URL (used by API and Worker when running outside Docker)
# =============================================================================
# For local dev with Docker Compose: postgresql://genesis:genesis@localhost:5432/genesis
DATABASE_URL=postgresql://genesis:genesis@localhost:5432/genesis

# =============================================================================
