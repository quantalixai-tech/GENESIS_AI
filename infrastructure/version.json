{
  "version": "0.4.0",
  "phase": "0.4",
  "description": "Core Platform Foundation — Infrastructure, API, Worker, Web Frontend",
  "services": [
    {
      "name": "postgres",
      "image": "genesis-postgres:local (from postgres:16-alpine)",
      "layer": "core",
      "port": 5432,
      "status": "active"
    },
    {
      "name": "nats",
      "image": "genesis-nats:local (from nats:2.10-alpine)",
      "layer": "core",
      "port": 4222,
      "status": "active"
    },
    {
      "name": "minio",
      "image": "minio/minio:latest",
      "layer": "core",
      "port": 9000,
      "status": "active"
    },
    {
      "name": "api",
      "image": "genesis-api:local (local build)",
      "layer": "platform",
      "port": 8080,
      "status": "active",
      "note": "FastAPI — auth, workspaces, projects. Service layer, structured errors, request tracing, JWT auth."
    },
    {
      "name": "worker",
      "image": "genesis-worker:local (local build)",
      "layer": "platform",
      "port": null,
      "status": "active",
      "note": "NATS consumer — stub, no real processing yet."
    },
    {
      "name": "web",
      "image": "genesis-web:local (local build)",
      "layer": "platform",
      "port": 3000,
      "status": "active",
      "note": "Next.js 16 frontend — landing page live, CSS modules + Tailwind v4, auth pages in progress."
    }
  ],
  "planned_services": [
    {
      "name": "ollama",
      "layer": "ai",
      "phase": "1.0",
      "status": "planned"
    },
    {
      "name": "model-router",
      "layer": "ai",
      "phase": "1.0",
      "status": "planned"
    },
    {
      "name": "prometheus",
      "layer": "observability",
      "phase": "1.0",
      "status": "planned"
    },
    {
      "name": "grafana",
      "layer": "observability",
      "phase": "1.0",
      "status": "planned"
    },
    {
      "name": "loki",
      "layer": "observability",
      "phase": "1.0",
      "status": "planned"
    }
  ],
  "networks": ["genesis-network"],
  "volumes": ["postgres-data", "nats-data", "minio-data"]
}
