{
  "version": "0.3.0",
  "phase": "0.3",
  "description": "Core Platform Foundation — Infrastructure, API, Worker",
  "services": [
    {
      "name": "postgres",
      "image": "genesis-postgres:local (from postgres:16-alpine)",
      "layer": "core",
      "port": 5432,
      "status": "active"
    },
    {
      "name": "nats",
      "image": "genesis-nats:local (from nats:2.10-alpine)",
      "layer": "core",
      "port": 4222,
      "status": "active"
    },
    {
      "name": "minio",
      "image": "minio/minio:latest",
      "layer": "core",
      "port": 9000,
      "status": "active"
    },
    {
      "name": "api",
      "image": "genesis-api (local build)",
      "layer": "platform",
      "port": 8080,
      "status": "active",
      "note": "FastAPI — auth, workspaces, projects. Runs via docker-compose.platform.yml"
    },
    {
      "name": "worker",
      "image": "genesis-worker (local build)",
      "layer": "platform",
      "port": null,
      "status": "active",
      "note": "NATS consumer — stub, no real processing yet. Runs via docker-compose.platform.yml"
    }
  ],
  "planned_services": [
    {
      "name": "web",
      "layer": "platform",
      "phase": "0.4",
      "status": "in-progress",
      "note": "Next.js frontend — landing page complete, app not yet wired to API"
    },
    {
      "name": "ollama",
      "layer": "ai",
      "phase": "1.0",
      "status": "planned"
    },
    {
      "name": "prometheus",
      "layer": "observability",
      "phase": "1.0",
      "status": "planned"
    },
    {
      "name": "grafana",
      "layer": "observability",
      "phase": "1.0",
      "status": "planned"
    }
  ],
  "networks": ["genesis-network"],
  "volumes": ["postgres-data", "nats-data", "minio-data"]
}
