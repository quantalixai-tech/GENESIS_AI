{
  "name": "GENESIS_AI",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "genesis:setup": "bash scripts/setup.sh",
    "genesis:up": "bash scripts/up.sh",
    "genesis:down": "bash scripts/down.sh",
    "genesis:restart": "bash scripts/restart.sh",
    "genesis:clean": "bash scripts/clean.sh"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
