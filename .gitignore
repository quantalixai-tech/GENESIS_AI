# =============================================================================
# Genesis — .gitignore
# =============================================================================

# ── Node.js / JS ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build Outputs ─────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.turbo/
# Per-package turbo caches and logs
**/.turbo/
# Turbo log files
**/*.log

# ── Agent Scratch ─────────────────────────────────────────────────────────────
# AI agent task files — local only, never commit
task.md

# ── Tooling ───────────────────────────────────────────────────────────────────
.vercel

# ── Python ────────────────────────────────────────────────────────────────────
# Single shared venv at repo root (created by `uv sync`)
.venv/
# Per-package venvs (e.g. packages/db/.venv from manual setup steps)
**/venv/
**/.venv/
# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc
# Distribution / packaging
*.egg
*.egg-info/
.eggs/
# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
# mypy
.mypy_cache/
# Ruff
.ruff_cache/

# ── Environment / Secrets ─────────────────────────────────────────────────────
# .env.example and .env.development are SAFE to commit (no real secrets)
# .env, .env.local, .env.*.local contain real secrets — NEVER commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem
*.key

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
